
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    function isModerator() {
      return hasRole('admin') || hasRole('superadmin');
    }

    // USER PROFILES
    match /users/{userId} {
      // Users can only read and write their own private data
      allow read, write: if isOwner(userId);
      
      // Superadmin can change roles, but cannot demote/delete the primary superadmins
      allow update: if hasRole('superadmin') 
        && !(resource.data.email in ['yikevin0421@daegu.ac.kr', 'rexshort160@daegu.ac.kr', 'sejin0604@daegu.ac.kr'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && (request.resource.data.role == 'admin' || request.resource.data.role == 'user');
        
      // Everyone can read basic public profile info (for display purposes)
      allow read: if isSignedIn();
    }

    // POSTS
    match /posts/{postId} {
      // Public reading
      allow read: if isSignedIn() && (resource.data.hidden == false || isModerator());
      
      // Ownership
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isModerator();
      
      // COMMENTS
      match /comments/{commentId} {
        allow read: if isSignedIn() && (resource.data.hidden == false || isModerator());
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isOwner(resource.data.userId) || isModerator();
      }
    }
  }
}
